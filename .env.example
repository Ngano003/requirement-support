# Requirements Support AI System - Docker Compose Configuration

# LLM Provider: "openrouter" or "vllm"
LLM_PROVIDER=openrouter

# OpenRouter Settings (for development/testing)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct

# vLLM Settings (for production)
VLLM_API_BASE=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
VLLM_API_KEY=

# Application Settings
MAX_TOKENS=4096
TEMPERATURE=0.7
MAX_QUESTIONS=15  # Maximum number of questions to generate (default: 15, recommended for testing: 5)

# Port Settings (for docker-compose)
# Backend will be available at http://localhost:8010
# Frontend will be available at http://localhost:3010
