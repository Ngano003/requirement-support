# Requirements Support AI System - Docker Compose Configuration

# LLM Provider: "openrouter" or "vllm" or "google"
LLM_PROVIDER=openrouter

# OpenRouter Settings (for development/testing)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct

# Google AI Settings
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
GOOGLE_AI_MODEL=gemini-2.0-flash-exp:free

# vLLM Settings (for production)
VLLM_API_BASE=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
VLLM_API_KEY=

# Application Settings
MAX_TOKENS=4096
TEMPERATURE=0.7
MAX_QUESTIONS=15  # Maximum number of questions to generate (default: 15, recommended for testing: 5)

# Network Settings (for remote access)
# Set this to the external IP or hostname where backend is accessible from client browsers
# Examples:
#   - http://192.168.1.100:8010 (LAN access)
#   - http://server.example.com:8010 (domain access)
#   - Leave empty for localhost-only access
NEXT_PUBLIC_BACKEND_URL=

# Proxy Settings (optional)
# Set these if you are behind a corporate proxy
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.local,.internal

# Port Settings (for docker-compose)
# Backend will be available at http://localhost:8010
# Frontend will be available at http://localhost:3010
