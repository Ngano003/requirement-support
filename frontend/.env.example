# Frontend Environment Variables

# Backend URL (optional)
# If not set, the frontend will automatically detect the backend URL based on the browser's hostname
# Set this only if the backend is on a different host or port than the default (port 8010)
# Examples:
#   NEXT_PUBLIC_BACKEND_URL=http://192.168.1.100:8010  (for LAN access)
#   NEXT_PUBLIC_BACKEND_URL=http://server.example.com:8010  (for external domain)
# NEXT_PUBLIC_BACKEND_URL=
